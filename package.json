{
  "name": "tactic",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "schema:validate": "sanity schemas validate",
    "schema:deploy": "sanity schemas deploy",
    "test:migration": "node --experimental-strip-types --test migrations/legacy-text-to-portable-text/*.test.mjs"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.18.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
